# v23.0
#!/bin/bash
# 环境配置模板
# 复制为 env.sh 并修改

# ============================================
# 模型配置
# ============================================

# 模型文件路径（必须修改）
export TANK_MODEL=/path/to/your/model.gguf

# 模型类型: qwen, llama, etc
export TANK_MODEL_TYPE=qwen

# ============================================
# GPU配置
# ============================================

# GPU分配（多卡系统）
export TANK_GPU_1=0  # 曹操 LLM
export TANK_GPU_2=1  # 夏侯惇 LLM
export TANK_GPU_3=2  # 夏侯渊 LLM

# GPU层数（根据显存调整）
# 999 = 全部层（需要24GB+显存）
# 80 = 大部分层（16GB显存）
# 60 = 一半层（12GB显存）
# 40 = 少量层（8GB显存）
export TANK_NGL=999

# 上下文长度
# 16384 = 标准（需要24GB+显存）
# 8192 = 中等（16GB显存）
# 4096 = 紧凑（12GB显存）
export TANK_CTX=16384

# ============================================
# 服务端口
# ============================================

# LLM服务端口
export TANK_AI_PORT_1=8080  # 曹操
export TANK_AI_PORT_2=8081  # 夏侯惇
export TANK_AI_PORT_3=8082  # 夏侯渊
export TANK_ADVISOR_PORT=8083  # 军师

# Pilot通讯端口
export TANK_UDP_PORT=8089

# ============================================
# 游戏配置
# ============================================

# 游戏窗口大小
export TANK_WIDTH=900
export TANK_HEIGHT=650

# 游戏帧率
export TANK_FPS=60

# 调试模式
export TANK_DEBUG=0

# ============================================
# 高级配置
# ============================================

# llama-server路径
export LLAMA_SERVER_BIN=/path/to/llama-server

# 并发数
export TANK_PARALLEL=1

# 线程数
export TANK_THREADS=8

# 批处理大小
export TANK_BATCH_SIZE=512

# ============================================
# 路径配置
# ============================================

# 项目根目录
export TANK_HOME=$(dirname $(dirname $(readlink -f $0)))

# 存档目录
export TANK_SAVES=$TANK_HOME/saves

# 日志目录
export TANK_LOGS=$TANK_HOME/logs
